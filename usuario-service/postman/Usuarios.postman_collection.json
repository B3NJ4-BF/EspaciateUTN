{
  "info": {
    "name": "Usuarios - Gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Consultar usuario ADMIN",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/api/usuarios/{{usuarioId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Negativo - sin token",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/api/usuarios/{{usuarioId}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Sin token devuelve 401/403', () => pm.expect([401,403]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    }
  ]
}